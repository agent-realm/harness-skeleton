#!/bin/sh
# A stand-in for pi, so the examples never start a real harness: it answers --version and nothing
# else. Point --bin at a real pi only on a disposable machine.
case "$1" in
  --version) echo "1.5.2" ;;
  *) echo "the examples' stand-in for pi: it answers --version only" >&2; exit 1 ;;
esac
